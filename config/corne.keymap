#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

// Pulsación rápida y repetición de Espacio/Enter; mantener activa Ctrl/capa.
&mt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
};

&lt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
};

// La matriz de ambas mitades puede despertar el teclado.
&kscan0 {
    wakeup-source;
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        adjust {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    behaviors {
        esc_del: esc_del {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Escape / Delete";
            tapping-term-ms = <180>;
            #binding-cells = <0>;
            bindings = <&kp ESC>, <&kp DEL>;
        };

        meta_screen: meta_screen {
            compatible = "zmk,behavior-tap-dance";
            display-name = "GUI / Screenshot";
            tapping-term-ms = <180>;
            #binding-cells = <0>;
            bindings = <&kp LGUI>, <&kp PRINTSCREEN>;
        };

        alt_gr: alt_gr {
            compatible = "zmk,behavior-tap-dance";
            display-name = "AltGr / Alt";
            tapping-term-ms = <180>;
            #binding-cells = <0>;
            bindings = <&kp RALT>, <&kp LALT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";

            bindings = <
&kp TAB     &kp Q  &kp W  &kp E          &kp R         &kp T                     &kp Y        &kp U  &kp I      &kp O    &kp P     &kp BSPC
&kp LSHIFT  &kp A  &kp S  &kp D          &kp F         &kp G                     &kp H        &kp J  &kp K      &kp L    &kp SEMI  &kp MINUS
&esc_del    &kp Z  &kp X  &kp C          &kp V         &kp B                     &kp N        &kp M  &kp COMMA  &kp DOT  &kp SQT   &kp SLASH
                          &kp BACKSLASH  &meta_screen  &mt LEFT_CONTROL SPACE    &lt RAISE ENTER  &mo LOWER  &alt_gr
            >;
        };

        lower_layer {
            display-name = "Lower Layer";

            bindings = <
&kp EXCLAMATION  &kp AT_SIGN  &kp HASH       &kp DOLLAR    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS    &kp HOME           &kp UP_ARROW     &kp END       &kp PAGE_UP       &kp C_BRI_UP  &kp BSPC
&kp PERCENT      &kp CARET    &kp AMPERSAND  &kp ASTERISK  &kp LEFT_BRACKET      &kp RIGHT_BRACKET        &kp LEFT           &kp DOWN         &kp RIGHT     &kp PAGE_DOWN     &kp C_BRI_DN  &trans
&trans           &trans       &trans         &trans        &kp LEFT_BRACE        &kp RIGHT_BRACE          &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_REWIND  &kp C_PLAY_PAUSE  &kp C_NEXT    &trans
                                             &trans        &trans                &trans                   &trans             &trans           &trans
            >;
        };

        raise_layer {
            display-name = "Raise Layer";

            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &kp F1  &kp F2      &kp F3   &kp F4       &kp N7        &kp N8        &kp N9        &kp MINUS  &kp ASTERISK  &kp BSPC
&bt BT_SEL 2  &bt BT_SEL 3  &kp F5  &kp F6      &kp F7   &kp F8       &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp PLUS   &kp SLASH     &kp GRAVE
&bt BT_SEL 4  &trans        &kp F9  &kp F10     &kp F11  &kp F12      &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp N0     &kp EQUAL     &kp TILDE
                                    &trans      &trans   &trans       &trans        &trans        &trans
            >;
        };
        adjust_layer {
            display-name = "Maintenance";
            // Mantener LOWER + RAISE. Bluetooth: limpiar solo el perfil actual.
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none    &out OUT_USB  &out OUT_BLE  &none  &none  &none  &none
&none         &none        &none        &none        &none        &none    &none         &none         &none  &none  &none  &none
&none         &none        &none        &none        &none        &none    &none         &none         &none  &none  &none  &bt BT_CLR
                                         &trans       &trans       &trans   &trans        &trans        &studio_unlock
            >;
        };
    };
};
